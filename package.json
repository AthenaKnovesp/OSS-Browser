{
  "name": "oss-browser",
  "version": "0.1.0",
  "description": "Windows desktop S3 compatible object storage browser",
  "author": "OSS Browser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AthenaKnovesp/OSS-Browser.git"
  },
  "homepage": "https://github.com/AthenaKnovesp/OSS-Browser#readme",
  "bugs": {
    "url": "https://github.com/AthenaKnovesp/OSS-Browser/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite --host 127.0.0.1",
    "clean:build": "node -e \"const fs=require('node:fs'); for (const dir of ['dist','release']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "build": "npm run typecheck && tauri build --no-bundle",
    "build:frontend": "vite build",
    "package:dir": "npm run verify && node scripts/package.mjs dir",
    "package": "npm run verify && tauri bundle --bundles nsis && node scripts/package.mjs nsis",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "audit": "npm audit --audit-level=high --registry=https://registry.npmjs.org",
    "audit:rust": "node scripts/audit-rust.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run check:rust && npm run test:rust && tauri build --no-bundle",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "antd": "^6.7.1",
    "dayjs": "^1.11.23",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  }
}
